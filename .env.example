# =====================================================
# VetApp — Environment variables template
# Copy this file to `.env` and fill in the values.
# =====================================================

# --- JWT (backend) ---------------------------------
JWT_ISSUER=https://localhost:8081
JWT_AUDIENCE=https://localhost:8081
# Generate a base64 secret (32+ bytes), e.g. via `openssl rand -base64 32`
JWT_SECRET=

# --- CORS (backend) --------------------------------
# Origin the frontend runs at during local dev (Vite default port 5173).
CORS_ORIGIN=http://localhost:5173

# --- SQL Server (docker container) ------------------
SA_PASSWORD=YourStrongPassword123!
DB_HOST=sqlserver
DB_PORT=1437
DB_NAME=VetRestApiDB
DB_USER=sa
DB_USER_PASSWORD=YourStrongPassword123!

# --- ASP.NET (backend container) --------------------
ASPNETCORE_ENVIRONMENT=Development
APP_PORT=8081
