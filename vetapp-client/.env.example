# =====================================================
# VetApp frontend — Environment variables template
# Copy this file to `.env` and adjust if the backend
# is running at a different URL.
# =====================================================

# Base URL of the backend REST API (must include /api/v1).
# For local dev with `dotnet run`:  https://localhost:7213/api/v1
# For docker-compose backend:       http://localhost:8081/api/v1
VITE_API_URL=https://localhost:7213/api/v1
